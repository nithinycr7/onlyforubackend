# Azure AI Configuration (Phase 1: AI Integration)
# Copy this file to .env and fill in your actual credentials

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure Speech Services (for multilingual transcription)
# Get these from Azure Portal: https://portal.azure.com
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=centralindia

# Azure Translator (for multilingual support)
# Get these from Azure Portal: https://portal.azure.com
AZURE_TRANSLATOR_KEY=your_translator_key_here
AZURE_TRANSLATOR_REGION=centralindia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/

# AI Feature Flags
ENABLE_AI_SUMMARIES=true
ENABLE_MULTILINGUAL_PROCESSING=true
MAX_AUDIO_DURATION_SECS=600
MAX_VIDEO_DURATION_SECS=300
